@article{grossmanlewis2014,
	abstract = { ABSTRACT Numerous developing countries have substantially increased their number of subnational administrative units in recent years. The literature on this phenomenon is, nonetheless, small and suffers from several theoretical and methodological shortcomings: in particular, a unit of analysis problem that causes past studies to mistakenly de-emphasize the importance of local actors. We posit that administrative unit proliferation occurs where and when there is a confluence of interests between the national executive and local citizens and elites from areas that are politically, economically, and ethnically marginalized. We argue further that although the proliferation of administrative units often accompanies or follows far-reaching decentralization reforms, it likely results in a recentralization of power; the proliferation of new local governments fragments existing units into smaller ones with lower relative intergovernmental bargaining power and administrative capacity. We find support for these arguments using original data from Uganda. },
	author = {Grossman, Guy and Lewis, Janet I},
	date-added = {2023-12-20 23:17:22 +0100},
	date-modified = {2023-12-20 23:17:22 +0100},
	doi = {10.1017/S0003055413000567},
	issn = {1537-5943},
	issue = {01},
	journal = {American Political Science Review},
	keywords = {districting, development, political economy},
	month = {2},
	numpages = {22},
	pages = {196--217},
	title = {Administrative Unit Proliferation},
	url = {http://journals.cambridge.org/article_S0003055413000567},
	volume = {108},
	year = {2014},
