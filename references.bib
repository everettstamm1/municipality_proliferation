@article{Hendrick_Shi_2015,
	abstract = { Empirical and theoretical research on government competition and collaboration identifies several important macro-level characteristics that can affect these forms of interaction between local governments within the same large jurisdiction. These characteristics are fragmentation of governments, fiscal dispersion of governments, sorting of population by governments, and decentralized fiscal responsibility between state and local governments. This study presents indices to measure these characteristics and examines how metropolitan regions in the United States with populations greater than one million are distributed on these indices. The study also examines how these regions compare on conditions that are likely to motivate sales tax competition between municipal governments. },
