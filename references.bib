	journal = {The Quarterly Journal of Economics},
	keywords = {urban, segregation, migration},
	number = {1},
	pages = {417-443},
	title = {Was Postwar Suburbanization ``White Flight''? Evidence from the Black Migration},
	url = {+ http://dx.doi.org/10.1162/qjec.2010.125.1.417},
	volume = {125},
	year = {2010},
	bdsk-file-1 = {},
