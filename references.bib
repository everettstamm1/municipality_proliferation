	issn = {0033-5533},
	journal = {The Quarterly Journal of Economics},
	keywords = {history, political economy, migration},
	month = {03},
	number = {3},
	pages = {1577-1647},
	title = {{The Other Great Migration: Southern Whites and the New Right*}},
