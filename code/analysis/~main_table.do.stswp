

// Controls
local b_controls reg2 reg3 reg4 sumshare_base
local extra_controls mean_income_1940 mfg_lfshare1940 cz_popdens1940 

// White controls
local w_b_controls reg2 reg3 reg4 sumshare_base_white 
local w_extra_controls growth1930 mean_income_1940 hsgrad_25 unigrad_25 frac_total mfg_lfshare1940 coastal




// Table 2: Black Migration Effect
use "$CLEANDATA/cz_pooled", clear

main_table_long_ssaggregate, endog(GM_raw_pp) exog(shift_share_base) controls(`b_controls' `extra_controls') weight(popc1940) path("$TABS/T2.tex") 	version("base")	share_folder("$INTDATA/ssaggregate_prep/") origin_id("origin_fips")

// Table 3: Dissolution
use "$CLEANDATA/cz_pooled", clear

fragmech_long_ssaggregate, endog(GM_raw_pp) exog(shift_share_base) controls(`b_controls' `extra_controls' ) weight(popc1940) path("$TABS/T3.tex") 	version("base")	share_folder("$INTDATA/ssaggregate_prep/") origin_id("origin_fips")



// Table A3: Townships
use "$CLEANDATA/cz_pooled", clear

main_table_towns_ssaggregate, endog(GM_raw_pp) exog(shift_share_base) controls(`b_controls' `extra_controls') weight(popc1940) path("$TABS/TA3.tex")  version("base") share_folder("$INTDATA/ssaggregate_prep/") origin_id("origin_fips")


// Table A5: Jurisdiction Decomp

use "$CLEANDATA/cz_pooled", clear
foreach outcome in cgoodman schdist_ind gen_town spdist gen_muni totfrac {
	drop n_`outcome'_cz_pc ld_`outcome'_cz_pc
	ren pct_`outcome'_cz_pc n_`outcome'_cz_pc
	ren  pct_ld_`outcome'_cz_pc ld_`outcome'_cz_pc
	
}
main_table_long_ssaggregate, endog(GM_raw_pp) exog(shift_share_base) controls(`b_controls' `extra_controls' ) weight(popc1940) path("$TABS/TA5.tex") 	version("base")	share_folder("$INTDATA/ssaggregate_prep/") origin_id("origin_fips")


// Table A6: Population Decomp

use "$CLEANDATA/cz_pooled", clear

foreach outcome in cgoodman schdist_ind gen_town spdist gen_muni totfrac {
	drop n_`outcome'_cz_pc ld_`outcome'_cz_pc
	ren decomp_`outcome'_cz_pc n_`outcome'_cz_pc
	ren decomp_ld_`outcome'_cz_pc ld_`outcome'_cz_pc
	
}
main_table_long_ssaggregate, endog(GM_raw_pp) exog(shift_share_base) controls(`b_controls' `extra_controls' ) weight(popc1940) path("$TABS/TA6.tex") 	version("base")	share_folder("$INTDATA/ssaggregate_prep/") origin_id("origin_fips")


// Table A7: 1950 base year

use "$CLEANDATA/cz_pooled", clear

main_table_long_ssaggregate2, endog(GM_raw_pp) exog(shift_share_base) controls(`b_controls' `extra_controls') weight(popc1940) path("$TABS/TA7.tex") 	version("base")	share_folder("$INTDATA/ssaggregate_prep/") origin_id("origin_fips")


// Table A13: No imbalanced controls
use "$CLEANDATA/cz_pooled", clear

main_table_long_ssaggregate, endog(GM_raw_pp) exog(shift_share_base) controls(`b_controls' ) weight(popc1940) path("$TABS/TA13.tex") 	version("base")	share_folder("$INTDATA/ssaggregate_prep/") origin_id("origin_fips")


// Table A14: All baseline controls

main_table_long_ssaggregate, endog(GM_raw_pp) exog(shift_share_base) controls(reg2 reg3 reg4 sumshare_base avg_precip avg_temp n_streams coastal mfg_lfshare1940 m_rr_sqm_total transpo_cost_1920 frac_total hsgrad_25 unigrad_25 mean_income_1940 cz_popdens1940 growth1930 mi_n_streams) weight(popc1940) path("$TABS/TA14.tex") 	version("base")	share_folder("$INTDATA/ssaggregate_prep/") origin_id("origin_fips")

// Table A17: Percentile Transformation

main_table_long, endog(GM) exog(GM_hat) controls(reg2 reg3 reg4 sumshare_base avg_precip transpo_cost_1920 frac_total mean_income_1940 cz_popdens1940) weight(popc1940) path("$TABS/TA17.tex")


// Table A18: European Migration Control

main_table_long_ssaggregate, endog(GM_raw_pp) exog(shift_share_base) controls(`b_controls' `extra_controls' wt_instmig_avg) weight(popc1940) path("$TABS/TA18.tex") 	version("base")	share_folder("$INTDATA/ssaggregate_prep/") origin_id("origin_fips")


// Table A20: White Migration Effect

main_table_long_ssaggregate, endog(WM_raw_pp) exog(shift_share_base_white) controls(reg2 reg3 reg4 sumshare_base_white growth1930 mean_income_1940 hsgrad_25 unigrad_25 mfg_lfshare1940 coastal) weight(popc1940) path("$TABS/TA20.tex") version("base_white")	share_folder("$INTDATA/ssaggregate_prep/") origin_id("origin_fips")


	